{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zawadi-bags",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-09-29",
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "zawadi-bags",
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ],
  "vars": {
    // Shown next to the paybill on the payment prompt. The admin panel can
    // override this, and the paybill number itself, at any time.
    "MPESA_PAYBILL": "247247",
    "MPESA_ACCOUNT_NUMBER": "0723266957",
    "MPESA_ACCOUNT_NAME": "Francis Ndereba"
  },
  "observability": { "enabled": true }
}
